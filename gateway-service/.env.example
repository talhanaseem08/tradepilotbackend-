GATEWAY_PORT=3000
NODE_ENV=development
JWT_EXPIRES_IN=4h
JWT_IDLE_TIMEOUT_MINUTES=30

# Public URL of the SPA (password reset links). Must match where users open the app.
FRONTEND_URL=http://localhost:5173

# --- Email (password reset). Without SMTP_* no real email is sent; the reset URL is logged. ---
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=TradePilot <you@gmail.com>
