# TradePilot production environment template
# Copy this file to .env.production on the server and fill real values there.
# Do not commit .env.production or any file containing real secrets.

# MongoDB runs inside Docker in the first deployment plan.
MONGO_URI=mongodb://mongodb:27017/tradepilot
MONGO_DB_NAME=tradepilot

# Redis runs inside Docker in the first deployment plan.
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication
# Generate a long random value for production.
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=4h
JWT_IDLE_TIMEOUT_MINUTES=30
JWT_ACTIVITY_REFRESH_SECONDS=60

# Broker credential encryption
# Generate a strong production-only key and keep it private.
ENCRYPTION_KEY=replace-with-a-strong-production-encryption-key

# Google Sign-In
# Use the production OAuth web client ID after adding your deployed domain in Google Cloud.
GOOGLE_CLIENT_ID=replace-with-production-google-client-id.apps.googleusercontent.com
# Public client ID embedded into the frontend build. It must match GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=replace-with-production-google-client-id.apps.googleusercontent.com

# Internal service URLs
# These stay as Docker service names in production.
NLP_SERVICE_URL=http://nlp-service:8001
TRADING_SERVICE_URL=http://trading-service:8002
AGENT_SERVICE_URL=http://agent-service:8003

# Forex broker and market data
# Practice URL: https://api-fxpractice.oanda.com
# Live URL: https://api-fxtrade.oanda.com
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# AI services
# If Ollama/DeepSeek runs on a separate machine, put that private server URL here.
OLLAMA_LOCAL_URL=http://host.docker.internal:11434
OLLAMA_REMOTE_URL=http://replace-with-ai-server-ip:11434
DEEPSEEK_MODEL=deepseek-r1:70b

# Trading mode
BROKER_MODE=broker

# Gateway
GATEWAY_PORT=3000

# Public website URL
# Keep localhost for the local production test. Replace it with the AWS URL before deployment.
FRONTEND_URL=http://localhost

# Password reset email, optional but recommended for production.
# Without these values, reset links may only be logged by the gateway.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=TradePilot <you@gmail.com>
