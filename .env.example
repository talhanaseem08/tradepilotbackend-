# MongoDB
MONGO_URI=mongodb://mongodb:27017/tradepilot
MONGO_DB_NAME=tradepilot

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=changeme-generate-a-real-secret-in-production
JWT_EXPIRES_IN=24h

# Google Sign-In (Web client ID from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
ENCRYPTION_KEY=changeme-32-char-key-for-broker-credential-encryption

# NLP URL — gateway (news/calendar/parse) and trading-service call NLP.
# In Docker: service name. If you run the gateway on the host and NLP with `uvicorn` on the host, use http://localhost:8001.
NLP_SERVICE_URL=http://nlp-service:8001
# Trading / agent — Docker Compose overrides these for the gateway container (see docker-compose.yml environment:).
TRADING_SERVICE_URL=http://trading-service:8002
AGENT_SERVICE_URL=http://agent-service:8003

# OANDA (forex candles / broker) — put real values in .env at this repo root.
# docker-compose.yml uses env_file: .env for trading-service (and other services).
# Rebuilding images does NOT remove .env; only deleting/editing that file does.
# Practice token must use practice URL; live token uses api-fxtrade.oanda.com.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Ollama (local on host for Mistral)
OLLAMA_LOCAL_URL=http://host.docker.internal:11434

# Ollama (remote AMD Developer Cloud for DeepSeek)
OLLAMA_REMOTE_URL=http://REPLACE_WITH_VM_IP:11434
DEEPSEEK_MODEL=deepseek-r1:70b
BROKER_MODE=broker

# Gateway
GATEWAY_PORT=3000
# Base URL of the web app — used in password-reset emails (must match Vite dev URL or production origin)
FRONTEND_URL=http://localhost:5173

# Password-reset emails (optional). Without these, no email is sent; link is logged on the gateway.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=TradePilot <you@gmail.com>
