# TradePilot gateway — omit in dev to use Vite proxy (/api → gateway) and avoid CORS/port issues.
# VITE_API_BASE_URL=http://localhost:3001

# When VITE_API_BASE_URL is unset, dev server proxies /api here. Docker Compose maps gateway to host :3001.
# VITE_PROXY_TARGET=http://127.0.0.1:3001
#
# Prompt page: POST /api/parse (→ nlp), POST /api/bots/from-parse, POST /api/backtest/run (gateway loads candles + runs backtest on trading-service). Run gateway, nlp, trading-service, and configure market data (e.g. OANDA for forex).

# Password-reset emails: set FRONTEND_URL on the gateway to this app’s origin (e.g. http://localhost:5173).

# Google Sign-In — Web client ID (Google Cloud Console → Credentials → OAuth 2.0 Client IDs)
# Must match gateway GOOGLE_CLIENT_ID. Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
